<div class="reset-password">
    <h1>Restablecer contraseña</h1>

    {{#if token}}
        <form id="reset-password-form">
            <label for="password">Nueva contraseña</label>
            <input type="password" id="password" name="password" placeholder="Mínimo 6 caracteres" required>

            <label for="confirm">Repetir contraseña</label>
            <input type="password" id="confirm" name="confirm" placeholder="Repetí la contraseña" required>

            <button type="submit">Restablecer contraseña</button>
        </form>

        <p id="message" class="message"></p>

        <script>
            const token = "{{token}}";
            const form = document.getElementById("reset-password-form");
            const message = document.getElementById("message");

            form.addEventListener("submit", async (event) => {
                event.preventDefault();

                const password = document.getElementById("password").value;
                const confirm = document.getElementById("confirm").value;

                if (password !== confirm) {
                    message.textContent = "Las contraseñas no coinciden";
                    return;
                }

                try {
                    const response = await fetch("/api/sessions/reset-password", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ token, password }),
                    });

                    const data = await response.json();
                    message.textContent = data.message;

                    if (response.ok) {
                        form.reset();
                    }
                } catch (error) {
                    message.textContent = "Error de conexión, intentá de nuevo";
                }
            });
        </script>
    {{else}}
        <p class="message">El enlace no es válido o expiró. Solicitá uno nuevo desde la página de login.</p>
    {{/if}}
</div>
